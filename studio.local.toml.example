# この PC 用の上書き。このファイルを studio.local.toml という名前でコピーして、必要な所だけ残します
# (studio.local.toml は git の管理外です)。studio.toml と同じ形式で、書いた項目だけが上書きされます。
#
# 既に minimax-h3 などを別の場所に入れているときは、そのエンジンの dir を書きます。
# 書いたエンジンは、setup が取り込みもモデル取得も飛ばします(その場所をそのまま使います)。
# パスは '...'(シングルクォート)で囲むと、Windows の \ をそのまま書けます。

# --- Windows の例 ---
# [components.h3]
# dir = 'C:\AI\minimax-h3'
# [components.h3image]
# dir = 'C:\AI\minimax-h3-image-server'
# [components.ace]
# dir = 'C:\AI\ACE-Step-1.5-fast'
# [components.aivis]
# dir = 'C:\AI\AivisSpeech-Engine'      # run.exe があるフォルダ(配布版を展開したもの)

# --- Linux の例 ---
# [components.h3]
# dir = "/home/you/minimax-h3"
# [components.h3image]
# dir = "/home/you/minimax-h3-image-server"
# [components.ace]
# dir = "/home/you/ACE-Step-1.5-fast"
# [components.aivis]
# dir = "/home/you/AivisSpeech-Engine"   # run があるフォルダ(Linux-x64 の 1 つ上でもよい)

# --- そのほかの上書き ---
# port = 8700                    # 管理役のポート
# components_dir = "D:/studio-components"   # エンジンを取り込む場所を変える
#
# [components.h3]
# enabled = false                # このエンジンを使わない
# port = 8612                    # エンジンのポートを変える(競合したとき)
# vram_budget_gb = 40            # share のときの VRAM の利用枠(GiB)を決め打ちする
# [components.h3.env]
# H3_VRAM_LIMIT_GB = "8"         # エンジンに渡す環境変数
#
# [gpu]
# mode = "share"                 # "auto"(既定。総 VRAM 40GiB 以上で share)/ "exclusive"(エンジン 1 つずつ)/ "share"(複数を同時に載せる)
# devices = "1"                  # GPU が 2 枚以上: 1 番の GPU を管理し、エンジンもそこで動かす("auto" = 既定 / "all" = 寄せない)
# [components.h3image.env]
# CUDA_VISIBLE_DEVICES = "0,1"   # このエンジンだけ 2 枚とも見せる(書いたものは上書きしない)
#
# [llm]
# gpu = "off"                    # 同梱 LLM を CPU だけで動かす("auto" / "off" / "all" / 層数)
# mmproj = "/path/to/mmproj-gemma-4-E4B-it-Q8_0.gguf"      # 画像・音声を読む投影ファイルを自分で用意したとき(空なら、自動で探す・取得する)

# MV・ショート動画タブの音声処理と、セリフのテロップ
# [mv]
# tools_python = ""          # 空なら setup が既定で作る components/mvtools/.venv の Python(--no-mv で飛ばした人は、MV タブの「道具を入れる」か setup --only mvtools)
# device = ""                # ボーカルの分離(Demucs)の装置。空なら CPU("cuda" で GPU)
# subtitle_font = ""         # テロップの字体。空なら Noto Sans CJK JP(Windows は "Meiryo" など)
